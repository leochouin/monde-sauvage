{
  "name": "monde-sauvage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "playwright:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:chaos": "playwright test e2e/chaos.spec.js --reporter=list",
    "test:chaos:ui": "playwright test e2e/chaos.spec.js --ui",
    "test:chaos:register": "CHAOS_REGISTER=1 playwright test e2e/chaos.spec.js --reporter=list",
    "audit:no-webgl": "node scripts/audit/no-webgl-fallback.cjs",
    "audit:auth-smoke": "node scripts/audit/auth-flow-smoke.cjs",
    "audit:booking-rls-smoke": "node scripts/audit/guide-booking-rls-smoke.cjs",
    "audit:recommended": "npm run audit:no-webgl && npm run audit:auth-smoke"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.1.0",
    "moment": "^2.30.1",
    "react": "19.2.3",
    "react-big-calendar": "^1.19.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "playwright": "^1.60.0",
    "vite": "^7.1.7"
  }
}
